{
  "checkedAt": "2026-10-13",
  "status": "configuration_verified_not_run",
  "actions": [
    {"uses": "actions/checkout@v7", "source": "https://github.com/actions/checkout", "observation": "官方README当前示例使用v7；默认PR检出可为模拟合并点，须读真实git HEAD。"},
    {"uses": "pnpm/setup@v3", "source": "https://github.com/pnpm/setup", "observation": "当前输入为runtime: node@24.12.0、install:false；packageManager取已有pnpm11.20.0。不使用旧node-version字段。"},
    {"uses": "actions/upload-artifact@v7", "source": "https://github.com/actions/upload-artifact", "observation": "官方当前示例使用v7；if:always保留实际记录，文件不存在时只如实告警。"}
