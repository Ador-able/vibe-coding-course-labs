{
  "name": "qinglan-continuous-agent-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "青岚修仙录：基于成熟 Harness 的连续 Agent 综合练习",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lab": "node scripts/current-lab.mjs",
