{
  "description": "只对真实保存返回检查约定的编辑占位符，不修改稿件或评价文学表现。",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__novel_lab__save_draft$",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-draft-placeholder.mjs correct",
            "timeout": 10,
            "statusMessage": "读取真实保存返回，检查编辑占位符"
          }
        ]
      }
    ]
  }
}
