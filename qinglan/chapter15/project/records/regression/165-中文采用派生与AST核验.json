  "comments": [
    [
      "// Teacher execution: set DELIVERY_BROWSER_CHANNEL explicitly, then",
      "// 先明确设置 DELIVERY_BROWSER_CHANNEL，再运行："
    ],
    [
      "// node --test scripts/test-saving.mjs (requires the existing dist; never builds).",
      "// node --test scripts/test-saving.mjs（使用已有 dist，不执行构建）。"
    ],
    [
      "// Run this same file/input at the restored historical point and frozen correct point.",
      "// 历史恢复点和正确版本使用同一脚本与输入。"
    ],
    [
      "// Historical red is an intentional comparison, not a newly found current-app defect.",
      "// 历史恢复点用于对照，当前正确应用的状态另行核对。"
    ],
    [
      "// Leaves a separate budget for all cleanup/recording.",
      "// 另留时间完成清理和记录。"
    ],
    [
      "// A fresh run-local nonexistent path prevents Git reading private",
      "// 使用本次运行目录内不存在的路径，避免读取私密全局 Git 配置。"
    ],
    [
      "// global configuration. This path is never created by the script.",
      "// 脚本不会创建这个配置路径。"
    ],
    [
      "// Observe the same IncomingMessage/ServerResponse as the real HTTP handler.",
      "// 在真实 HTTP 处理器的 IncomingMessage/ServerResponse 上记录。"
    ],
    [
      "// No extra handler answers a request; stream bytes and finish/abort are recorded.",
      "// 只记录流字节和 finish/abort，不另行响应请求。"
    ],
    [
      "// Explicitly leave the dirty page during the one refresh; no draft is saved.",
      "// 刷新时确认离开带有本地编辑的页面，不保存这些编辑。"
    ],
    [
      "// Hidden controls are included only in this observation, never in an action.",
      "// 隐藏控件只用于观察，不操作。"
    ],
    [
      "// A real mouse click followed by real keyboard events. A disabled field",
      "// 使用真实鼠标和键盘，观察禁用字段是否拒绝焦点和输入。"
    ],
    [
      "// naturally rejects focus/input; there is no fill, DOM assignment or force.",
      "// 不使用 fill、DOM 赋值或强制操作。"
    ],
    [
      "// No shared practice.json/data path, and no reused database or directory.",
      "// 每例使用新目录和数据库，不读取共享练习配置。"
    ],
    [
      "// Release both gates even after an observation failure. Cleanup can complete",
      "// 观察失败后也放行两个门，清理可能完成仍在等待的真实保存。"
    ],
    [
      "// a pending real save; the resulting final database is recorded explicitly.",
      "// 因此清理后再次完整记录数据库。"
    ],
    [
      "// If the filesystem refuses the record, preserve the complete diagnostic",
      "// 记录写入失败时，将完整诊断留在 stderr 并报失败。"
    ],
    [
      "// on stderr and fail; do not report a successful disk delivery or retry.",
      "// 不重试，也不把未落盘记录报作成功。"
    ],
    [
      "// Sequential, independent node:test cases. A historical normal failure must not",
      "// 两个独立用例顺序运行，历史正常保存失败后仍执行 abort 观察。"
    ],
    [
      "// prevent the service-before abort observation from running with its own seed.",
      "// 每例都单独初始化完整三章。"
    ]
  ],
