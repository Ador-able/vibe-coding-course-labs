+    // a pending real save; the resulting final database is recorded explicitly.
+    postGate.open('finally release');
+    getGate.open('finally release');
+    if (page) {
+      await cleanup('route handlers settle', () => Promise.all([...routeTasks]));
+      await cleanup('routes removed', () => page.unrouteAll({behavior: 'wait'}));
