+function pairChapter(chapter) { return {title: chapter.title, body: chapter.body}; }
+
+async function runScenario(scenario) {
+  const id = randomUUID(), directory = resolve(project, 'runs', `regression-${id}`);
+  const database = resolve(directory, 'practice.sqlite'), recordPath = resolve(directory, 'record.json');
+  const report = {kind: 'saving_regression_observation', id, scenario, startedAt: now(),
+    directory, database, recordPath,
+    scope: '完整三章来自既有课堂存档；本次seed为新作品human/draft r1。程序检查不表示文学采用。历史恢复点只用于独立红绿对照；正确工作台在另一个冻结副本。',
+    limits: ['每场景一个工作台、一次保存尝试，无布局循环和自动重试。',
+      'abort仅发生在服务收到请求前，不覆盖服务提交后断网、撤销或回滚。',
+      '未覆盖GET失败、未知终态、并发写入、所有空白字符及页面审美。'],
+    environment: {cwd: process.cwd(), project, node: process.version, platform: process.platform,
+      arch: process.arch, deliveryBrowserChannel: process.env.DELIVERY_BROWSER_CHANNEL ?? null,
+      waitLimitsMs: {action: ACTION_LIMIT, request: LIMIT, step: STEP_LIMIT,
+        observations: OBSERVATION_LIMIT, nodeTest: TEST_LIMIT}},
+    sources: {}, pages: [], databases: [], service: [], browserNetwork: [], gates: [],
+    console: [], dialogs: [], pageErrors: [], assertions: [], completed: [],
+    environmentErrors: [], observationErrors: [], recordingErrors: [], cleanupErrors: [], cleanup: [], sourceChanges: []};
+  let store, server, browser, context, page, seedModule, input, expectation, A, finalDb;
+  const observed = {}, captures = new Set(), routeTasks = new Set();
+  const observationDeadline = Date.now() + OBSERVATION_LIMIT;
+  const postGate = makeGate('post', report), getGate = makeGate('get', report);
+  let postUsed = false, getUsed = false, saveReadArmed = false;
+  function persist(label) {
+    report.lastCheckpoint = {label, at: now()};
+    report.unfinished = planned[scenario].filter(step => !report.completed.includes(step));
+    try {
+      writeFileSync(recordPath, JSON.stringify(report, null, 2) + '\n', 'utf8');
+      return true;
+    }
+    catch (error) {
+      report.recordingErrors.push({kind: 'write', label, recordPath, error: errorRecord(error)});
+      process.stderr.write(`Record write failed: ${recordPath}: ${error.message}\n`);
+      return false;
+    }
+  }
+  async function step(name, action) {
+    report.activeStep = name;
+    const remaining = observationDeadline - Date.now();
+    if (remaining <= 0) throw new Error('Observation budget exhausted; proceeding to cleanup and final recording.');
+    observed[name] = await bounded(Promise.resolve().then(action), `observation/${name}`, Math.min(STEP_LIMIT, remaining));
+    report.completed.push(name);
+    report.observed = observed;
+    persist(name);
+    return observed[name];
+  }
+  async function cleanup(name, action) {
+    const entry = {name, startedAt: now()};
+    report.cleanup.push(entry);
+    try { await bounded(Promise.resolve().then(action), `cleanup/${name}`); entry.completedAt = now(); }
+    catch (error) { report.cleanupErrors.push({name, error: errorRecord(error)}); }
+  }
+  const draftMatch = url => url.pathname === '/api/draft';
+  const workMatch = url => url.pathname === '/api/work';
+  const trackedRoute = action => route => {
