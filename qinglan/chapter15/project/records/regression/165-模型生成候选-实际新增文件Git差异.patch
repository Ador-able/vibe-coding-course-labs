+    routeTasks.add(job);
+    void job.finally(() => routeTasks.delete(job));
+    return job;
+  };
+  const draftHandler = trackedRoute(async route => {
+    if (route.request().method() !== 'POST' || postUsed) { await route.continue(); return; }
+    postUsed = true;
+    postGate.arrive(route.request());
