+      getGate.entry.continuedAt = now();
+    }
+    await route.continue();
+  });
+  try {
+    // No shared practice.json/data path, and no reused database or directory.
+    mkdirSync(resolve(project, 'runs'), {recursive: true});
+    mkdirSync(directory);
+    report.environment.gitBefore = gitState(directory);
+    readSources(report);
+    input = JSON.parse(report.sources['inputs/完整教师初始化.json'].utf8);
+    expectation = JSON.parse(report.sources['inputs/独立业务预期.json'].utf8);
+    report.inputs = {initialization: input, expectation};
+    const original = input.chapters.find(chapter => chapter.number === expectation.chapterNumber);
+    A = plus(pairChapter(original), expectation.edits.before);
+    report.independentExpectedA = A;
+    persist('inputs');
+    const {Store} = await import('../dist/store.js');
+    const {prototypeServer} = await import('../dist/prototype-http.js');
+    seedModule = await import('./seed.mjs');
+    store = new Store(database);
+    report.initialization = seedModule.seed(store);
+    databaseState(store, seedModule.snapshot, input.work.id, report, 'seed');
+    persist('seed');
+    const channel = report.environment.deliveryBrowserChannel;
+    if (!channel || !channel.trim()) throw new Error('DELIVERY_BROWSER_CHANNEL must explicitly specify the browser channel; no fallback is allowed.');
+    const [nodeMajor, nodeMinor] = process.versions.node.split('.').map(Number);
+    if (nodeMajor !== 24 || nodeMinor < 12) {
