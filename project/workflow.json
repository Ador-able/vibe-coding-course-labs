        -420,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.document.downloadUrl }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "fullResponse": true,
              "outputPropertyName": "sourceFile",
              "neverError": false
            }
          },
          "timeout": 30000
        }
      },
      "retryOnFail": false
    },
    {
      "id": "3fe9f1cd-829f-4764-92da-bdddf28018cb",
      "name": "保留本项身份与下载",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -200,
        120
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  requestId: $('逐项资料').item.json.requestId,\n  sourceId: $('逐项资料').item.json.document.sourceId,\n  fileName: $('逐项资料').item.json.document.fileName,\n  expectedMimeType: $('逐项资料').item.json.document.expectedMimeType,\n  downloadUrl: $('逐项资料').item.json.document.downloadUrl,\n  actualMimeType: $binary.sourceFile.mimeType,\n  binaryField: 'sourceFile',\n  binaryMetadata: {\n    fileName: $binary.sourceFile.fileName,\n    mimeType: $binary.sourceFile.mimeType,\n    fileExtension: $binary.sourceFile.fileExtension,\n    fileSize: $binary.sourceFile.fileSize,\n    bytes: $binary.sourceFile.bytes\n  },\n  downloadResponse: {\n    statusCode: $json.statusCode,\n    statusMessage: $json.statusMessage,\n    headers: $json.headers\n  }\n}) }}",
        "includeOtherFields": true,
        "include": "selected",
        "includeFields": "statusCode",
        "options": {
          "stripBinary": false
        }
      }
    },
    {
      "id": "45d75439-7f85-458f-bf88-10b804eb2a98",
      "name": "按实际MIME选择",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        20,
        120
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "516bfe68-1606-4941-a59b-f4d7921757f4",
                    "leftValue": "={{ $json.actualMimeType }}",
                    "rightValue": "application/pdf",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PDF"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "9aff6125-e804-4548-94d4-c6cdddf837b1",
                    "leftValue": "={{ $json.actualMimeType }}",
                    "rightValue": "text/plain",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "TXT"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "未支持类型",
          "allMatchingOutputs": false
        }
      }
    },
    {
      "id": "678e2dd7-d366-4108-bc8b-4b672493389c",
