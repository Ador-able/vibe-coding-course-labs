      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  requestId: $json.requestId,\n  sourceId: $json.sourceId,\n  fileName: $json.fileName,\n  expectedMimeType: $json.expectedMimeType,\n  downloadUrl: $json.downloadUrl,\n  actualMimeType: $json.actualMimeType,\n  binaryField: $json.binaryField,\n  binaryMetadata: $json.binaryMetadata,\n  downloadResponse: $json.downloadResponse,\n  parser: $json.actualMimeType === 'application/pdf' ? 'Extract From File: PDF' : 'Extract From File: Text',\n  rawParsedText: $json.text,\n  parsedPageCount: Array.isArray($json.text) ? $json.text.length : null,\n  pdfMetadata: $json.actualMimeType === 'application/pdf' ? {\n    numpages: $json.numpages,\n    numrender: $json.numrender,\n    info: $json.info,\n    metadata: $json.metadata,\n    version: $json.version\n  } : null,\n  preparedText: (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text),\n  materialStatus: typeof (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text) === 'string' && (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text).trim().length > 0 ? 'text_available' : 'text_empty',\n  preparedPrompt: typeof (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text) === 'string' && (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text).trim().length > 0 ? \"请只依据下面提供的完整章节文字，说明林澈已经直接观察到什么、哪些原因仍不知道。分别列出已观察事实和待查问题，每项附一段来自本材料的原文。不要根据文件编号、文件名或故事常识补出原因，不续写故事。\\n\\n材料来源：\" + $json.sourceId + \"\\n文件名：\" + $json.fileName + \"\\n完整提取文字：\\n\" + (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text) : null,\n  stage: typeof (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text) === 'string' && (Array.isArray($json.text) ? $json.text.join('\\n\\n') : $json.text).trim().length > 0 ? 'prepared_not_sent' : 'material_incomplete'\n}) }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "5db7d6b3-7473-43d8-87e0-2876abc129aa",
      "name": "汇集完整两项",
