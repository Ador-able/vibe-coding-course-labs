        "jsonOutput": "={{ JSON.stringify({\n  requestId: $('文件目录').first().json.requestId,\n  stage: $json.documents.length === 2 && $json.documents.every(d => d.materialStatus === 'text_available') ? 'prepared_not_sent' : 'material_incomplete',\n  documentCount: $json.documents.length,\n  documents: $json.documents,\n  modelRequestCount: 0,\n  notificationStatus: 'not_sent'\n}) }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
