{
  "lexical": {
    "engine": "@orama/orama@3.1.18",
    "tokenizer": "@orama/tokenizers@3.1.18/mandarin",
    "tokenizerStatus": "官方README将中文分词标为experimental；须保存实际tokens，分词命中不等于完整编号相同",
    "properties": [
      "text"
    ],
    "exact": false,
    "threshold": 1,
    "relevance": {
      "k": 1.2,
      "b": 0.75,
      "d": 0
    },
    "limit": 3,
    "tolerance": 0
  },
  "semantic": {
    "sdk": "ai@7.0.122",
    "provider": "@ai-sdk/openai-compatible@3.0.59",
    "model": "text-embedding-v4",
    "dimensions": 1024,
    "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "batchSize": 10,
    "maxRetries": 0,
    "maxParallelCalls": 1,
    "timeoutMs": 60000,
    "measure": "AI SDK cosineSimilarity",
    "limit": 3,
    "queriesAre": "教师固定的语义查询，不是模型改写结果"
  },
  "fusion": {
    "algorithm": "RRF",
    "k": 60,
    "rankStartsAt": 1,
    "uniqueKey": "corpus.id",
    "onlyInputs": "各路满足同一where后的top3；未进入候选的原文不被融合补出",
    "tieBreak": "id字典序",
    "keepAllUnion": true
  },
  "rerank": {
    "actualModelCalls": 0,
    "method": "人工对完整候选及原页作相关性/支持关系回查；可复制rerank迁移卡未运行，不填造模型输出"
  },
  "scope": {
    "existingChunks": 18,
    "teacherWholeMemoChunks": 4,
    "corpusTexts": 22,
    "semanticQueries": 3,
    "embeddingValues": 25,
    "maximumNaturalEmbeddingRequests": 3,
    "newAnswerGenerationCalls": 0,
    "newPdfParsingCalls": 0,
    "chapterSaveCalls": 0
  }
}
