{
  "name": "ai-request-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts --production",
    "structured:dev": "node --import tsx src/structured/server.ts",
    "structured:start": "node --import tsx src/structured/server.ts --production",
    "streaming:dev": "node --import tsx src/streaming/server.ts",
    "streaming:start": "node --import tsx src/streaming/server.ts --production",
    "streaming:replay": "vite --host 127.0.0.1 --port 4332 --strictPort",
    "messages:dev": "node --import tsx src/message-history/server.ts",
    "messages:check": "tsc --noEmit --project tsconfig.messages.json",
    "messages:build": "vite build --config vite.messages.config.ts",
    "messages:inspect": "node scripts/messages-inspect.mjs",
    "messages:lock": "node scripts/messages-lock.mjs",
    "requests:dev": "node --import tsx src/requests/server.ts",
    "requests:check": "tsc --noEmit --project tsconfig.requests.json",
    "requests:build": "vite build --config vite.requests.config.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.59",
    "ai": "7.0.122",
    "eventsource-parser": "4.1.1",
    "express": "^5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
