{
  "name": "agent-practice-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "使用成熟 Codex Harness 的 AI 任务教学实验",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lab": "node dist/cli.js",
    "agent": "node dist/agent.js",
    "mcp": "node dist/mcp.js",
    "mcp:inspect": "node scripts/inspect-mcp.mjs",
    "plugin:prepare": "node scripts/prepare-plugin.mjs",
    "plugin:catalog": "node scripts/plugin-catalog.mjs",
    "plugin:add": "node scripts/plugin-manage.mjs add",
    "plugin:remove": "node scripts/plugin-manage.mjs remove",
    "plugin:check": "node dist/plugin-check.js",
    "skill:catalog": "node scripts/skill-catalog.mjs",
    "skill:observe": "node scripts/observe-skill.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/codex-sdk": "0.160.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
