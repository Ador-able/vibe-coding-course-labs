{
  "tools": [
    {
      "name": "read_work",
      "title": "读取当前作品要求",
      "description": "取得指定作品的用途、设定、要求、大纲和当前要求修订；保存前先读。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "workId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "facts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outline": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "titleHint": {
                      "type": "string",
                      "minLength": 1
                    },
                    "goal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "number",
                    "titleHint",
                    "goal"
                  ],
                  "additionalProperties": false
                }
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "title",
              "purpose",
              "requirements",
              "facts",
              "outline",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "save_draft",
      "title": "保存章节草稿",
      "description": "按当前要求与正文修订保存指定章的完整标题和正文。expectedPreviousRevisions 提供前面全部章节的修订，第一章为 []。初次正文修订为 0；旧基线被拒绝时重读并判断，不原样重试。状态始终 draft。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "chapterNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expectedWorkRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expectedChapterRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expectedPreviousRevisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "number",
                "revision"
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workId",
          "chapterNumber",
          "expectedWorkRevision",
          "expectedChapterRevision",
          "expectedPreviousRevisions",
          "title",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "workId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "adopted"
                ]
              },
              "workRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "origin": {
                "type": "string",
                "enum": [
                  "human",
                  "agent"
                ]
              },
              "taskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "threadId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updatedAt": {
                "type": "string"
              },
              "previousRevisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "number",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              },
              "reviewNote": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "workId",
              "number",
              "revision",
              "title",
              "body",
              "status",
              "workRevision",
              "origin",
              "taskId",
              "threadId",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
