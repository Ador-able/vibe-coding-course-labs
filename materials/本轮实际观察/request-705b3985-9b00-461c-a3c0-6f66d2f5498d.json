          "delta": "共享书架计划于1"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "0月12日下午开"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "放，林晓负责图书"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "整理，许宁负责借"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "阅说明制作。书架"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "与阅读桌已到位，"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "图书仅限在活动室"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "内阅读，不外借，"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "每次限20人，使"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "用后需归位。志愿"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "者值班名单及开放"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "具体时间待与场地"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "管理员确认。借阅"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "说明中损坏处理方"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "式未定。材料整理"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "完成后将评估是否"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "如期开放，暂不对"
        },
        {
          "type": "text-delta",
          "id": "705b3985-9b00-461c-a3c0-6f66d2f5498d:text:1",
          "delta": "外承诺。"
        },
        {
          "type": "text-end",
