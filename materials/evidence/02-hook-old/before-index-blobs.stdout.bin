import {Codex,type ThreadEvent,type Usage} from '@openai/codex-sdk';
import {randomUUID} from 'node:crypto';
import {appendFile,mkdir,readFile,writeFile} from 'node:fs/promises';
import {parseArgs} from 'node:util';
import {resolve} from 'node:path';
import {execFileSync} from 'node:child_process';
import {Store} from './store.js';
import {workId,chapterNumber} from './schemas.js';

const {values}=parseArgs({options:{db:{type:'string',default:'data/novel.sqlite'},work:{type:'string',default:'clocktower'},chapter:{type:'string',default:'1'},'resume-task':{type:'string'},'cancel-after-ms':{type:'string'}}});
const root=process.cwd(),db=resolve(values.db!);
const store=new Store(db);
const id=workId.parse(values.work),number=chapterNumber.parse(Number(values.chapter));
const previousTask=values['resume-task']?store.getTask(values['resume-task']):null;
if(previousTask&&!previousTask.threadId)throw new Error('原任务尚未取得 Harness 会话标识，不能接续。');
if(previousTask&&previousTask.workId!==id)throw new Error('本实验接续同一作品的任务；另一作品请开始新会话。');
const taskId=randomUUID(),runDir=resolve('runs',taskId);
await mkdir(runDir,{recursive:true});
let config:{model?:string;codexPathOverride?:string}={};
try{config=JSON.parse(await readFile('lab.config.json','utf8'));}catch(error){if((error as NodeJS.ErrnoException).code!=='ENOENT')throw error;}
const codeVersion=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
store.createTask({id:taskId,workId:id,chapterNumber:number,codeVersion});
const baseline=store.getChapter(id,number);
const prompt=`请完成作品 ${id} 的第 ${number} 章草稿任务。先使用 novel_lab 的 read_work、list_chapters 和 read_chapter 读取当前用途、设定、大纲、要求、目标章及前面每章的正文和修订。${previousTask?'这是使用旧 Harness 会话接续的新任务；业务资料可能已由人工入口修改。记忆或旧回复不能代替当前读取。':''}依据当前材料生成约 800 至 1200 个中文字符的完整章节，使用 save_draft 真实保存，再用 read_chapter 和 list_chapters 核对。expectedPreviousRevisions 应逐项记录前面各章的当前修订，第一章为 []。只调用 novel_lab 业务工具，不使用 shell、直接写文件或其他插件。发现关键条件冲突或旧资料与现在不同，依据当前资料；重要取舍无法据现有材料决定时准确说明，不猜测、不用旧基线覆盖。不要自行采用稿件。最后只汇报作品、章节、实际保存修订、保存状态及待人工判断事项；完成宣言不能替代读回结果。`;
await writeFile(resolve(runDir,'input.json'),JSON.stringify({taskId,workId:id,chapterNumber:number,db,codeVersion,baselineRevision:baseline?.revision??0,previousTaskId:previousTask?.id??null,requestedThreadId:previousTask?.threadId??null,configuredModel:config.model??null,runtime:'项目锁定 Codex SDK 及其 CLI',prompt},null,2));
const controller=new AbortController();
const cancel=()=>controller.abort();
process.once('SIGINT',cancel);
let timer:ReturnType<typeof setTimeout>|undefined;
if(values['cancel-after-ms']){
  const delay=Number(values['cancel-after-ms']);
  if(!Number.isFinite(delay)||delay<=0)throw new Error('取消延迟必须为正数。');
  timer=setTimeout(cancel,delay);
}
let completed=false,error:string|null=null,usage:Usage|null=null,finalResponse='';
const toolCalls:unknown[]=[];
store.updateTask(taskId,{state:'running'});
console.log(JSON.stringify({taskId,state:'running',runDir}));
try{
  const codex=new Codex({codexPathOverride:config.codexPathOverride,config:{plugins:{'novel-practice@novel-agent-lab':{enabled:false}},mcp_servers:{novel_lab:{command:process.execPath,args:[resolve('dist/mcp.js'),db,taskId],cwd:root,required:true,enabled:true,default_tools_approval_mode:'approve'}}}});
  const options={workingDirectory:root,sandboxMode:'read-only' as const,approvalPolicy:'never' as const,webSearchMode:'disabled' as const,model:config.model};
  const thread=previousTask?.threadId?codex.resumeThread(previousTask.threadId,options):codex.startThread(options);
  const {events}=await thread.runStreamed(prompt,{signal:controller.signal});
  for await(const event of events){
    await appendFile(resolve(runDir,'events.jsonl'),JSON.stringify(event)+'\n');
    if(event.type==='thread.started')store.updateTask(taskId,{threadId:event.thread_id});
    if(event.type==='turn.completed'){completed=true;usage=event.usage;}
    if(event.type==='turn.failed')error=event.error.message;
    if(event.type==='error')error=event.message;
    if(event.type==='item.completed'&&event.item.type==='agent_message')finalResponse=event.item.text;
    if(event.type==='item.completed'&&event.item.type==='mcp_tool_call')toolCalls.push(event.item);
    // 终端只显示运行变化，完整公开事件保存在本轮记录中。
    const progress:Record<string,unknown>={event:event.type};
    if('item' in event){progress.itemType=event.item.type;if(event.item.type==='mcp_tool_call'){progress.tool=event.item.tool;progress.status=event.item.status;}}
    console.log(JSON.stringify(progress));
  }
}catch(cause){error=cause instanceof Error?cause.message:String(cause);}
finally{
  if(timer)clearTimeout(timer);
  process.removeListener('SIGINT',cancel);
}
const state=controller.signal.aborted?'cancelled':error?'failed':completed?'completed':'interrupted';
const task=store.updateTask(taskId,{state,error,usage});
const chapter=store.getChapter(id,number);
const savedDuringTask=chapter?.taskId===taskId;
await writeFile(resolve(runDir,'final-response.txt'),finalResponse,'utf8');
await writeFile(resolve(runDir,'chapter.json'),JSON.stringify(chapter,null,2));
const report={task,baselineRevision:baseline?.revision??0,savedDuringTask,chapter:chapter?{number:chapter.number,revision:chapter.revision,status:chapter.status,workRevision:chapter.workRevision,taskId:chapter.taskId,threadId:chapter.threadId,characters:chapter.body.length}:null,toolCalls,finalResponse,limits:'运行状态与保存结果分别记录；文学品质和设定语义仍需人读正文判断。'};
await writeFile(resolve(runDir,'report.json'),JSON.stringify(report,null,2));
console.log(JSON.stringify({taskId,threadId:task.threadId,state,savedDuringTask,revision:chapter?.revision??null,status:chapter?.status??null,runDir,error}));
store.close();
if(state!=='completed'||!savedDuringTask)process.exitCode=1;

753d9c2c1ef94bc6daffd936baa7bb0c67cdf86a blob 2955
import {readFile,writeFile} from 'node:fs/promises';
import {parseArgs} from 'node:util';
import {resolve} from 'node:path';
import {Store} from './store.js';
import {workInput,workId,chapterNumber,draftInput,LabError} from './schemas.js';
import {z} from 'zod';

const {values,positionals}=parseArgs({allowPositionals:true,options:{db:{type:'string',default:'data/novel.sqlite'},work:{type:'string',default:'clocktower'},output:{type:'string'},'expected-revision':{type:'string'},note:{type:'string'}}});
const store=new Store(resolve(values.db!));
try{
  const id=workId.parse(values.work);
  const [command,arg]=positionals;
  let result:unknown;
  switch(command){
    case 'init':result=store.init(workInput.parse(JSON.parse(await readFile(arg??'seed/钟楼.json','utf8'))));break;
    case 'show':result={work:store.getWork(id),chapters:store.listChapters(id)};break;
    case 'chapter':result=store.getChapter(id,chapterNumber.parse(Number(arg)));break;
    case 'work-version':result=store.getWorkVersion(id,z.number().int().positive().parse(Number(arg)));break;
    case 'save':{
      if(!arg)throw new LabError('INPUT_REQUIRED','需要带修订基线的草稿 JSON 文件。');
      result=store.saveDraft(draftInput.parse(JSON.parse(await readFile(arg,'utf8'))),'human');break;
    }
    case 'update':{
      if(!arg)throw new LabError('INPUT_REQUIRED','需要新的完整作品要求 JSON。');
      const input=workInput.parse(JSON.parse(await readFile(arg,'utf8')));
      if(input.id!==id)throw new LabError('WORK_MISMATCH','文件作品与 --work 不一致。');
      result=store.updateWork(input,z.number().int().positive().parse(Number(values['expected-revision'])));break;
    }
    case 'adopt':result=store.adopt(id,chapterNumber.parse(Number(arg)),z.number().int().positive().parse(Number(values['expected-revision'])),z.string().trim().min(1).parse(values.note));break;
    case 'export':{
      if(!arg)throw new LabError('INPUT_REQUIRED','需要导出 Markdown 文件路径。');
      const exported=store.exportWork(id);
      await writeFile(resolve(arg),exported.text,'utf8');
      const {text,...summary}=exported;result={...summary,path:resolve(arg)};break;
    }
    case 'task':if(!arg)throw new LabError('INPUT_REQUIRED','需要任务标识。');result=store.getTask(arg);break;
    default:throw new LabError('COMMAND','用法：pnpm lab init | show | chapter 1 | save 草稿.json | update 要求.json --expected-revision N | adopt 1 --expected-revision N --note 理由 | export 草稿.md | task 任务标识 [--db 路径] [--work clocktower]');
  }
  const text=JSON.stringify(result,null,2)+'\n';
  if(values.output)await writeFile(resolve(values.output),text,'utf8');
  else process.stdout.write(text);
}catch(error){console.error(JSON.stringify({code:error instanceof LabError?error.code:'INPUT_ERROR',message:error instanceof Error?error.message:String(error)}));process.exitCode=1;}
finally{store.close();}

1f8c3394f8744695b2d4c7aaa71b1f3f2753f2e4 blob 2566
import {McpServer} from '@modelcontextprotocol/sdk/server/mcp.js';
import {StdioServerTransport} from '@modelcontextprotocol/sdk/server/stdio.js';
import type {CallToolResult} from '@modelcontextprotocol/sdk/types.js';
import {Store} from './store.js';
import {workId, draftInput, workOutput, chapterOutput, LabError} from './schemas.js';

const dbPath = process.argv[2];
if (!dbPath) throw new Error('需要数据库路径。');
const store = new Store(dbPath);
const server = new McpServer({name: 'novel-two-tools', version: '0.1.0'}, {
  instructions: '先读取当前作品要求，按取得的修订和明确请求保存草稿；没有采用或发布能力。',
});

// MCP 只整理调用结果，资料读取和修订检查由已有业务函数完成。
function result(action: () => unknown): CallToolResult {
  try {
    const structuredContent = {result: action()};
    return {structuredContent, content: [{type: 'text', text: JSON.stringify(structuredContent)}]};
  } catch (error) {
    const failure = {
      code: error instanceof LabError ? error.code : 'STORE_ERROR',
      message: error instanceof Error ? error.message : String(error),
    };
    console.error(JSON.stringify({toolError: failure}));
    return {isError: true, content: [{type: 'text', text: JSON.stringify(failure)}]};
  }
}

server.registerTool('read_work', {
  title: '读取当前作品要求',
  description: '取得指定作品的用途、设定、要求、大纲和当前要求修订；保存前先读。',
  inputSchema: {workId},
  outputSchema: {result: workOutput},
  annotations: {readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false},
}, ({workId}) => result(() => store.getWork(workId)));

server.registerTool('save_draft', {
  title: '保存章节草稿',
  description: '按当前要求与正文修订保存指定章的完整标题和正文。expectedPreviousRevisions 提供前面全部章节的修订，第一章为 []。初次正文修订为 0；旧基线被拒绝时重读并判断，不原样重试。状态始终 draft。',
  inputSchema: draftInput.shape,
  outputSchema: {result: chapterOutput},
  annotations: {readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: false},
}, input => result(() => store.saveDraft(input, 'agent')));

const transport = new StdioServerTransport();
transport.onclose = () => store.close();
await server.connect(transport);
// 关闭输入意味着客户端结束本地连接，服务释放自己的资料库。
process.stdin.once('end', () => server.close());

e27fa83b94b3d366f00d95c4a9af35637156cd82 blob 6711
import {McpServer,ResourceTemplate} from '@modelcontextprotocol/sdk/server/mcp.js';
import {StdioServerTransport} from '@modelcontextprotocol/sdk/server/stdio.js';
import {ErrorCode,McpError,type CallToolResult,type ReadResourceResult} from '@modelcontextprotocol/sdk/types.js';
import {z} from 'zod';
import {Store} from './store.js';
import {workId,chapterNumber,draftInput,workOutput,chapterOutput,LabError} from './schemas.js';

const dbPath=process.argv[2];
if(!dbPath)throw new Error('需要数据库路径。');
const taskId=process.argv[3]??null;
const store=new Store(dbPath);
const server=new McpServer({name:'novel-lab',version:'0.1.0'},{instructions:'先读取当前作品要求及正文，依据返回的修订保存草稿；保存后读回。这里不提供人工采用能力。'});
const readAnnotations={readOnlyHint:true,destructiveHint:false,idempotentHint:true,openWorldHint:false};
const result=(action:()=>unknown):CallToolResult=>{
  try{const data=action();const structuredContent={result:data};return {structuredContent,content:[{type:'text',text:JSON.stringify(structuredContent)}]};}
  catch(error){
    const failure={code:error instanceof LabError?error.code:'STORE_ERROR',message:error instanceof Error?error.message:String(error)};
    console.error(JSON.stringify({toolError:failure}));
    return {isError:true,content:[{type:'text',text:JSON.stringify(failure)}]};
  }
};
server.registerTool('read_work',{title:'读取当前作品要求',description:'取得有效用途、设定、大纲及要求修订；写作和保存前先调用。',inputSchema:{workId},outputSchema:{result:workOutput},annotations:readAnnotations},({workId})=>result(()=>store.getWork(workId)));
server.registerTool('list_chapters',{title:'查询已保存章节',description:'查询真实保存数量、各章修订和人工采用状态，不包含正文。',inputSchema:{workId},outputSchema:{result:z.object({chapters:z.array(chapterOutput.omit({body:true}))})},annotations:readAnnotations},({workId})=>result(()=>({chapters:store.listChapters(workId)})));
server.registerTool('read_chapter',{title:'读回完整章节',description:'取得一章的当前正文和修订；不存在时 result 为 null。保存后用它核对实际内容。',inputSchema:{workId,chapterNumber},outputSchema:{result:chapterOutput.nullable()},annotations:readAnnotations},({workId,chapterNumber})=>result(()=>store.getChapter(workId,chapterNumber)));
server.registerTool('save_draft',{title:'保存章节草稿',description:'按当前要求、正文和前文基线保存草稿。expectedPreviousRevisions 逐项列出第1章至上一章的修订，写第1章时为 []。没有旧正文时 expectedChapterRevision=0。状态始终 draft；冲突时重读，不重试旧基线。',inputSchema:draftInput.shape,outputSchema:{result:chapterOutput},annotations:{readOnlyHint:false,destructiveHint:false,idempotentHint:false,openWorldHint:false}},input=>result(()=>store.saveDraft(input,'agent',taskId)));

const workUri=(id:string)=>`novel://works/${id}/requirements`;
const chapterUri=(id:string,number:number)=>`novel://works/${id}/chapters/${number}`;
const resourceResult=(uri:URL,action:()=>unknown):ReadResourceResult=>{
  try{return {contents:[{uri:uri.href,mimeType:'application/json',text:JSON.stringify(action())}]};}
  catch(error){
    if(error instanceof z.ZodError)throw new McpError(ErrorCode.InvalidParams,'资源地址参数不符合格式。');
    if(error instanceof LabError)throw new McpError(-32002,error.message,{uri:uri.href,code:error.code});
    throw error;
  }
};
server.registerResource('work_requirements',new ResourceTemplate('novel://works/{workId}/requirements',{list:()=>({resources:store.listWorks().map(work=>({name:`${work.id}-requirements`,uri:workUri(work.id),title:work.title,mimeType:'application/json'}))})}),{title:'当前作品要求',description:'读取时取得数据库当前资料；目录或此前读取不代替本次有效修订。',mimeType:'application/json'},(uri,variables)=>resourceResult(uri,()=>store.getWork(workId.parse(variables.workId))));
server.registerResource('chapter_text',new ResourceTemplate('novel://works/{workId}/chapters/{chapterNumber}',{list:()=>({resources:store.listWorks().flatMap(work=>store.listChapters(work.id).map(chapter=>({name:`${work.id}-chapter-${chapter.number}`,uri:chapterUri(work.id,chapter.number),title:`第 ${chapter.number} 章 ${chapter.title}`,mimeType:'application/json'})))})}),{title:'当前章节正文',description:'读取已保存正文、修订及状态；不存在的章不是空白已完成稿。',mimeType:'application/json'},(uri,variables)=>resourceResult(uri,()=>{
  const chapter=store.getChapter(workId.parse(variables.workId),chapterNumber.parse(Number(variables.chapterNumber)));
  if(!chapter)throw new LabError('CHAPTER_NOT_FOUND','该章正文尚未保存。');
  return chapter;
}));
server.registerPrompt('review_chapter',{title:'检查一章的依据与表现',description:'由人选择检查对象；取得当前资料、正文和检查方法，不运行模型、不改变稿件状态。',argsSchema:{workId,chapterNumber:z.string().regex(/^[1-9]\d*$/).transform(Number).pipe(chapterNumber)}},({workId,chapterNumber})=>{
  const work=store.getWork(workId),chapter=store.getChapter(workId,chapterNumber);
  if(!chapter)throw new McpError(-32002,'该章正文尚未保存。');
  const previous=store.listChapters(workId).filter(item=>item.number<chapterNumber).map(item=>store.getChapter(workId,item.number)!);
  const documents=[{uri:workUri(workId),data:work},...previous.map(data=>({uri:chapterUri(workId,data.number),data})),{uri:chapterUri(workId,chapterNumber),data:chapter}];
  return {description:`检查 ${work.title} 第 ${chapterNumber} 章 r${chapter.revision} 的当前快照`,messages:[
    {role:'user',content:{type:'text',text:`请检查作品 ${workId} 的第 ${chapterNumber} 章。先核对目标、资料修订、前文修订和保存状态，再对照每条关键设定与原文具体句子，区分确定矛盾、可能问题和资料未说明的情况。表达与创作取舍请给具体阅读理由，不能以模型自评分代替人的判断。只提出检查结果和仍待人决定的事项，不保存、不采用。下面是本次取得的资料快照；业务状态以后可能变化，准备修改时必须重读。`}},
    ...documents.map(document=>({role:'user' as const,content:{type:'resource' as const,resource:{uri:document.uri,mimeType:'application/json',text:JSON.stringify(document.data)}}}))
  ]};
});
const transport=new StdioServerTransport();
transport.onclose=()=>store.close();
await server.connect(transport);
process.stdin.once('end',()=>server.close());

