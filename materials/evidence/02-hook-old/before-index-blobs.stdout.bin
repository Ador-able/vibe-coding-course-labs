:root{font-family:"Segoe UI","Microsoft YaHei",sans-serif;color:#213047;background:#f2f4f7;font-size:15px;color-scheme:light}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.5}button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #5e9bdf;outline-offset:3px}button{border:1px solid #c7d0db;background:#fff;color:#273b56;border-radius:5px;padding:9px 15px}#app{max-width:1160px;margin:32px auto 80px;padding:0 28px}.eyebrow{font-size:12px;letter-spacing:.1em;color:#53677c}.work-heading h1{font-size:26px;margin:8px 0 10px}.work-heading p{line-height:1.7;margin:0 0 24px;color:#617086}.workspace{display:block;background:#fff;border:1px solid #d6dce5;padding:24px}.navigation h2{font-size:17px;margin:0 0 12px}#chapters{display:flex;gap:12px;margin-bottom:16px}.chapter{display:flex;align-items:center;text-align:left;gap:12px;flex:1;min-width:0}.chapter-number{color:#748398;font-size:14px}.chapter strong,.chapter small{display:block}.chapter small{font-size:12px;color:#69798e;margin-top:4px}.chapter[aria-current=page]{background:#eaf1fb;border-color:#81a9d3}.navigation details{margin-bottom:24px;border-bottom:1px solid #dde2e8;padding-bottom:16px}summary{cursor:pointer;font-size:14px;color:#576b83}#work-context h3{font-size:13px;color:#53677c;margin:20px 0 8px}#work-context ul{padding-left:20px;margin:0;line-height:1.75;font-size:13px;color:#53677c}.draft-heading{display:flex;justify-content:space-between;align-items:end;gap:18px;margin:14px 0 22px}.draft-heading h2{font-size:24px;margin:7px 0 0}.draft-heading p{font-size:13px;color:#6c7a8c;margin:0}label{display:block;font-size:13px;font-weight:600;margin:16px 0 8px}input,textarea{display:block;width:100%;border:1px solid #b9c5d2;border-radius:5px;padding:12px 14px;background:#fff;color:#253346}textarea{font-size:16px;line-height:1.95;resize:vertical;min-height:470px}#draft-title{font-size:18px}.actions{display:flex;align-items:center;justify-content:end;gap:10px;margin-top:18px}.actions p{margin:0 auto 0 0;font-size:12px;color:#62758b}.primary{background:#285f98;color:#fff;border-color:#285f98}.feedback{display:flex;align-items:start;justify-content:space-between;gap:14px;margin-top:18px}.feedback p{font-size:13px;line-height:1.7;margin:0;color:#576f84}.feedback p[data-kind=error]{color:#a03932}.feedback p[data-kind=notice]{color:#815828}.feedback button{font-size:13px;white-space:nowrap}#comparison{margin-top:24px;padding-top:24px;border-top:1px solid #e0b7af}#comparison header{display:flex;align-items:center;justify-content:space-between;gap:12px}#comparison h3{font-size:16px;margin:0}#comparison p{font-size:13px;line-height:1.7;color:#815828}#remote-body{min-height:280px;background:#faf8f5}.lab-footer{font-size:12px;color:#7c8999;padding-top:20px}.variant-switcher{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);display:flex;gap:6px;align-items:center;padding:7px 8px;background:#fff;border:1px solid #bdc8d6;border-radius:8px;box-shadow:0 4px 20px #1723341a;z-index:5}.variant-switcher span{font-size:12px;color:#758398;margin:0 8px}.variant-switcher button{font-size:12px;border:0;padding:7px 12px;background:transparent}.variant-switcher button[aria-pressed=true]{background:#e9eff7;color:#245483}
@media(max-width:720px){#app{margin:20px auto 82px;padding:0 14px}.workspace{padding:16px}#chapters{gap:5px}.chapter{padding:9px 8px;gap:7px}.chapter strong{font-size:13px}.chapter-number{display:none}.chapter small{font-size:11px}.draft-heading{display:block}.draft-heading p{margin-top:12px}.work-heading h1{font-size:24px}.actions{flex-wrap:wrap}.actions p{width:100%;margin-bottom:5px}textarea{min-height:420px}.variant-switcher{white-space:nowrap}.feedback{display:block}.feedback button{margin-top:12px}}
/* 比较控件放在正文外，三种方案都可以连续阅读与编辑。 */
.variant-switcher{position:static;transform:none;width:max-content;margin:0 auto 26px}.variant-switcher button{min-height:32px}
/* 台面将作品与章节留在左侧，中央连续承载当前稿件。 */
body[data-variant=desk]{background:#e7ecec;color:#203538}body[data-variant=desk] #app{max-width:1380px;margin:28px auto 24px;padding:0 32px;display:grid;grid-template-columns:234px minmax(0,1fr);column-gap:30px;align-items:start}body[data-variant=desk] .work-heading{grid-column:1;grid-row:1;padding:20px 3px 6px}body[data-variant=desk] .work-heading h1{font-size:22px;line-height:1.5;margin:9px 0 14px}body[data-variant=desk] .work-heading p{font-size:13px;line-height:1.9;margin-bottom:20px}body[data-variant=desk] .workspace{display:contents}body[data-variant=desk] .navigation{grid-column:1;grid-row:2;padding:3px}body[data-variant=desk] .navigation h2{font-size:13px;color:#657779;font-weight:500;margin-bottom:10px}body[data-variant=desk] #chapters{display:block}body[data-variant=desk] .chapter{width:100%;border:0;border-radius:3px;background:transparent;padding:14px 12px;margin:3px 0;gap:13px}body[data-variant=desk] .chapter[aria-current=page]{background:#d4e2e1;color:#1b5655}body[data-variant=desk] .chapter small{color:#6b8182}body[data-variant=desk] .navigation details{border-top:1px solid #cbd6d6;border-bottom:0;margin-top:24px;padding:18px 4px 0}body[data-variant=desk] .draft-panel{grid-column:2;grid-row:1/4;background:#fff;padding:34px 38px 30px;border:1px solid #d9e1e1;border-radius:4px}body[data-variant=desk] .draft-heading{margin:0 0 24px;padding-bottom:18px;border-bottom:1px solid #e1e7e7}body[data-variant=desk] .draft-heading h2{font-size:25px}body[data-variant=desk] .draft-heading p{color:#6d8282}body[data-variant=desk] input{border-color:#bccdcd}body[data-variant=desk] textarea{border:1px solid #d1dcdc;background:#fcfdfd;font-size:17px;line-height:2;min-height:600px;padding:22px 25px}body[data-variant=desk] .body-label,body[data-variant=desk] .title-label{color:#607776}body[data-variant=desk] .primary{background:#276563;border-color:#276563}body[data-variant=desk] .actions{padding-top:6px}body[data-variant=desk] .lab-footer{grid-column:1;grid-row:3;padding:24px 3px;color:#7c9090}
/* 笔记页用横向章节与连续文本面形成阅读顺序。 */
body[data-variant=notes]{background:#f6f3ed;color:#3a3530}body[data-variant=notes] #app{max-width:1060px;margin:36px auto 26px;padding:0 36px}body[data-variant=notes] .work-heading{padding:0 4px 24px;border-bottom:1px solid #d8d0c3}body[data-variant=notes] .work-heading h1{font-family:"Songti SC","SimSun",serif;font-size:28px;line-height:1.6;margin:8px 0}body[data-variant=notes] .work-heading p{font-size:14px;line-height:1.9;margin-bottom:0;color:#797064}body[data-variant=notes] .eyebrow{color:#8b7a63;letter-spacing:.12em}body[data-variant=notes] .workspace{border:0;background:transparent;padding:22px 4px 0}body[data-variant=notes] .navigation h2{font-size:12px;font-weight:500;color:#928572;letter-spacing:.13em}body[data-variant=notes] #chapters{gap:28px;border-bottom:1px solid #e0d7ca;margin-bottom:10px}body[data-variant=notes] .chapter{border:0;border-radius:0;background:transparent;border-bottom:2px solid transparent;padding:9px 0 17px;gap:13px}body[data-variant=notes] .chapter[aria-current=page]{border-bottom-color:#867148;color:#57451e}body[data-variant=notes] .chapter-number{font-family:Georgia,serif;font-size:22px;color:#b7a688}body[data-variant=notes] .chapter strong{font-weight:500;font-size:15px}body[data-variant=notes] .chapter small{color:#9b8e7c;margin-top:6px}body[data-variant=notes] .navigation details{margin:0 0 24px;padding:10px 0;border:0}body[data-variant=notes] .draft-panel{background:#fffefb;padding:28px 36px 27px;border-top:1px solid #e5dece;border-bottom:1px solid #e5dece}body[data-variant=notes] .draft-heading{margin:0 0 24px;align-items:center}body[data-variant=notes] .draft-heading h2{font-family:"Songti SC","SimSun",serif;font-weight:600;font-size:26px;color:#4b412f}body[data-variant=notes] .draft-heading p{color:#938777}body[data-variant=notes] label{font-size:12px;letter-spacing:.08em;color:#93816c;font-weight:400}body[data-variant=notes] #draft-title{font-family:"Songti SC","SimSun",serif;border:0;border-bottom:1px solid #ddd4c7;border-