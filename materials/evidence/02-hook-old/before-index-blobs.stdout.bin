@media(max-width:720px){.variant-switcher{margin-bottom:24px}body[data-variant=desk] #app{display:block;padding:0 14px;margin:12px auto 24px}body[data-variant=desk] .work-heading{padding:10px 3px 0}body[data-variant=desk] .work-heading p{margin-bottom:15px}body[data-variant=desk] .navigation{padding:0 3px}body[data-variant=desk] #chapters{display:flex;gap:7px}body[data-variant=desk] .chapter{padding:10px 8px}body[data-variant=desk] .chapter strong{font-size:12px}body[data-variant=desk] .navigation details{padding-top:12px;margin-top:14px;margin-bottom:20px}body[data-variant=desk] .draft-panel{padding:23px 17px;border-radius:3px}body[data-variant=desk] .draft-heading h2{font-size:22px}body[data-variant=desk] textarea{font-size:16px;min-height:450px;padding:15px 12px}body[data-variant=desk] .lab-footer{padding-top:16px}body[data-variant=notes] #app{margin:20px auto 24px;padding:0 17px}body[data-variant=notes] .work-heading{padding-bottom:20px}body[data-variant=notes] .work-heading h1{font-size:25px}body[data-variant=notes] #chapters{gap:9px}body[data-variant=notes] .chapter{padding-bottom:13px}body[data-variant=notes] .chapter strong{font-size:13px}body[data-variant=notes] .draft-panel{padding:23px 17px}body[data-variant=notes] .draft-heading h2{font-size:23px}body[data-variant=notes] .draft-heading p{font-size:12px}body[data-variant=notes] textarea{font-size:17px;line-height:1.95;min-height:450px}body[data-variant=notes] .navigation details{margin-bottom:14px}}
