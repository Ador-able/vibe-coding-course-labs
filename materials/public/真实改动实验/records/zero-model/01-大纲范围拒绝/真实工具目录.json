{
  "tools": [
    {
      "name": "read_work",
      "title": "读取当前作品要求",
      "description": "取得有效用途、设定、大纲及要求修订；写作和保存前先调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "workId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "facts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outline": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "titleHint": {
                      "type": "string",
                      "minLength": 1
                    },
                    "goal": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "number",
                    "titleHint",
                    "goal"
                  ],
                  "additionalProperties": false
                }
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "title",
              "purpose",
              "requirements",
              "facts",
              "outline",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_chapters",
      "title": "查询已保存章节",
      "description": "查询真实保存数量、各章修订和人工采用状态，不包含正文。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "workId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "workId": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "adopted"
                      ]
                    },
                    "workRevision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "human",
                        "agent"
                      ]
                    },
                    "taskId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "threadId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "previousRevisions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "number": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "revision": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "number",
                          "revision"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "reviewNote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "workId",
                    "number",
                    "revision",
                    "title",
                    "status",
                    "workRevision",
                    "origin",
                    "taskId",
                    "threadId",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "chapters"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "read_chapter",
      "title": "读回完整章节",
      "description": "取得一章的当前正文和修订；不存在时 result 为 null。保存后用它核对实际内容。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "chapterNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "workId",
          "chapterNumber"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "workId": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "number": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "revision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "adopted"
                    ]
                  },
                  "workRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "human",
                      "agent"
                    ]
                  },
                  "taskId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "threadId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "updatedAt": {
                    "type": "string"
                  },
                  "previousRevisions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "number": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "revision": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "number",
                        "revision"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reviewNote": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "workId",
                  "number",
                  "revision",
                  "title",
                  "body",
                  "status",
                  "workRevision",
                  "origin",
                  "taskId",
                  "threadId",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "save_draft",
      "title": "保存章节草稿",
      "description": "按当前要求、正文和前文基线保存草稿。expectedPreviousRevisions 逐项列出第1章至上一章的修订，写第1章时为 []。没有旧正文时 expectedChapterRevision=0。状态始终 draft；冲突时重读，不重试旧基线。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "chapterNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expectedWorkRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expectedChapterRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expectedPreviousRevisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "number",
                "revision"
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workId",
          "chapterNumber",
          "expectedWorkRevision",
          "expectedChapterRevision",
          "expectedPreviousRevisions",
          "title",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "workId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "adopted"
                ]
              },
              "workRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "origin": {
                "type": "string",
                "enum": [
                  "human",
                  "agent"
                ]
              },
              "taskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "threadId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updatedAt": {
                "type": "string"
              },
              "previousRevisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "number",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              },
              "reviewNote": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "workId",
              "number",
              "revision",
              "title",
              "body",
              "status",
              "workRevision",
              "origin",
              "taskId",
              "threadId",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "export_work",
      "title": "取得完整待审 Markdown",
      "description": "取得指定作品当前已保存章节的完整 Markdown、修订和采用状态，按章号返回全部已保存正文。不写文件、不修改正文、不采用或发布。没有已保存章节时返回空目录和仅含作品信息的文本。allOutlineChaptersSaved 只表示大纲中的章节已有保存对象，不表示稿件被人认可。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "workId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "workId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "workRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "expectedChapters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "savedChapters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "allOutlineChaptersSaved": {
                "type": "boolean"
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "adopted"
                      ]
                    },
                    "workRevision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "previousRevisions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "number": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "revision": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "number",
                          "revision"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "reviewNote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "basisCurrent": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "number",
                    "revision",
                    "status",
                    "workRevision",
                    "previousRevisions",
                    "reviewNote",
                    "basisCurrent"
                  ],
                  "additionalProperties": false
                }
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "workId",
              "workRevision",
              "expectedChapters",
              "savedChapters",
              "allOutlineChaptersSaved",
              "chapters",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
